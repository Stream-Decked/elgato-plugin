{
  "name": "stream-decked",
  "displayName": "StreamDecked",
  "version": "0.1.0",
  "description": "Bridges the Minecraft StreamDecked mod to the Stream Deck app over a local WebSocket.",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w",
    "validate": "streamdeck validate io.github.stream-decked.sdPlugin",
    "pack": "streamdeck pack io.github.stream-decked.sdPlugin -o dist -f"
  },
  "devDependencies": {
    "@elgato/cli": "^1.7.0",
    "@rollup/plugin-commonjs": "^28.0.2",
    "@rollup/plugin-node-resolve": "^16.0.0",
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^12.1.2",
    "@tsconfig/node20": "^20.1.4",
    "@types/node": "22.13.0",
    "@types/ws": "^8.18.1",
    "rollup": "^4.32.1",
    "tslib": "^2.8.1",
    "typescript": "^5.7.3"
  },
  "dependencies": {
    "@elgato/streamdeck": "^3.0.1",
    "@elgato/utils": "0.6.0",
    "ws": "^8.18.0"
  }
}
